# Supabase (names only; values live in .env.local, which is never committed)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secret (never NEXT_PUBLIC_, never in client code). App: only lib/supabase/admin.ts reads
# it, for Sign up's account check (owner decision 2026-11-04); without it Sign up falls back to its
# browser-only check. Tests: the signed-in specs use it to create throwaway users and mint sign-in
# codes, and skip without it. Also set it as the GitHub Actions secret SUPABASE_SECRET_KEY, and in
# each deployment's server environment.
SUPABASE_SECRET_KEY=
# Optional: set to 1 to run the sign-up spec that sends a real email (needs Resend SMTP on the project).
E2E_REAL_SIGNUP=
