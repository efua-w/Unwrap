{
  "name": "unwrap",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "tokens:build": "node scripts/build-tokens.ts",
    "tokens:check": "node scripts/check-tokens.ts",
    "test": "vitest run",
    "e2e": "playwright test",
    "db:migration:new": "supabase migration new",
    "db:types": "supabase gen types typescript --local --schema public > lib/supabase/database.types.ts",
    "db:test": "supabase test db"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "next": "^16.4.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.4",
    "supabase": "3.0.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
